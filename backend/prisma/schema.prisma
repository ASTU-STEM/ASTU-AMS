datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ALUMNI
  EMPLOYER
  DEPARTMENT_HEAD
  REGISTRAR
  ALUMNI_OFFICE
}

enum SyncStatus {
  SUCCESS
  FAILED
}

enum AlumniStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFERED
  HIRED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_ICT_ADMIN
  RESOLVED
  CLOSED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             Role
  isActive         Boolean           @default(false)
  twoFactorEnabled Boolean           @default(false)
  adminNotes       String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  alumniProfile         AlumniProfile?
  employerProfile       EmployerProfile?
  departmentHeadProfile DepartmentHeadProfile?
  adminProfile          AdminProfile?
  notifications         Notification[]
  auditLogs        AuditLog[]
  tracerNotifications TracerNotification[]
}

model Department {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  code                  String                  @unique // e.g. SWE, MEG, ECE
  alumniProfiles        AlumniProfile[]
  departmentHeadProfiles DepartmentHeadProfile[]
  surveys               Survey[]
  createdAt             DateTime                @default(now())
}

model DepartmentHeadProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String     @unique
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AdminProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  department   String?
  employeeId   String?
  bio          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AlumniProfile {
  id             String            @id @default(uuid())
  userId         String?           @unique
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId      String            @unique
  fullName       String
  email          String?
  phone          String?
  cgpa           Float
  graduationYear Int
  gender         String
  dateOfBirth    DateTime?
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id])
  registrarRecordId String?       @unique
  registrarRecord   RegistrarStudent? @relation(fields: [registrarRecordId], references: [id])
  status         AlumniStatus      @default(INACTIVE)
  employmentStatus EmploymentStatus @default(UNEMPLOYED)
  salary         Float?
  isVerified     Boolean           @default(false)
  isCgpaPublic   Boolean           @default(true)
  pendingVerificationCode String?
  verificationCodeExpiresAt DateTime?
  pendingPasswordHash String?
  verificationChannel String?
  pendingVerificationAttempts Int @default(0)
  profilePicture String?
  // New extended profile fields
  bio            String?
  nationality    String?
  maritalStatus  String?
  volunteerWork  String?
  address        String?
  languages      String[]
  preferences    Json?             @default("{}")

  // Existing arrays and relations
  skills         String[]          // Array of skills
  resumeUrl      String?
  linkedIn       String?
  gitHub         String?
  portfolio      String?
  telegram       String?
  twitterUrl     String?

  certifications Certification[]
  projects       Project[]
  achievements   Achievement[]

  experiences    WorkExperience[]
  applications   JobApplication[]
  surveyResponses SurveyResponse[]
  surveyAssignments SurveyAssignment[]
  documentRequests DocumentRequest[]
  verificationRequests VerificationRequest[]
  employerFeedback EmployerFeedback[]
  eventRsvps     EventRSVP[]
  mentorRequests MentorshipRequest[] @relation("MentorRequests")
  menteeRequests MentorshipRequest[] @relation("MenteeRequests")
  savedJobs      SavedJob[]
  jobViews       JobView[]
  jobRecommendations JobRecommendation[]
  directMessages DirectMessage[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // New relations for community & giving
  forumPosts         ForumPost[]
  forumComments      ForumComment[]
  forumLikes         ForumLike[]
  mentorProfile      MentorProfile?
  mentorshipSessions MentorshipSession[]
  donations          DonationRecord[]
  eventRegistrations EventRegistration[]
}

model Certification {
  id              String        @id @default(uuid())
  alumniProfileId String
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  name            String
  issuer          String
  issueDate       String?
  expiryDate      String?
  credentialUrl   String?
  imageUrl        String?
  description     String?
  createdAt       DateTime      @default(now())
}

model Project {
  id              String        @id @default(uuid())
  alumniProfileId String
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  technologies    String[]
  url             String?
  imageUrl        String?
  role            String?
  startDate       String?
  endDate         String?
  createdAt       DateTime      @default(now())
}

model Achievement {
  id              String        @id @default(uuid())
  alumniProfileId String
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  date            String?
  type            String        // 'award', 'publication', 'patent', 'recognition'
  createdAt       DateTime      @default(now())
}

model WorkExperience {
  id          String        @id @default(uuid())
  alumniId    String
  alumni      AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  companyName String
  position    String
  industry    String
  salaryRange String?       // e.g. "20k-30k", "50k+"
  location    String?       // e.g. "Addama", "Addis Ababa", "Remote"
  isCurrent   Boolean       @default(false)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime      @default(now())
}

model EmployerProfile {
  id          String             @id @default(uuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  industry    String
  website     String?
  location    String
  hrContact   String
  tin         String?            @unique
  logoUrl     String?
  isVerified  Boolean            @default(false)
  jobs        Job[]
  feedbacks   EmployerFeedback[]
  description String?
  companySize String?
  contactPerson String?
  contactEmail String?
  phone       String?
  directMessages DirectMessage[]
  isPremium   Boolean            @default(false)
  partnerships String[]          @default([])
  verificationStatus String      @default("NOT_VERIFIED")
  ndaSigned   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Job {
  id                 String           @id @default(uuid())
  employerId         String
  employer           EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  salary             String?
  salaryMin          Float?           // Numeric min for range filtering
  salaryMax          Float?           // Numeric max for range filtering
  deadline           DateTime
  experienceRequired Int              @default(0) // in years
  skillsRequired     String[]
  location           String
  employmentType     String           // e.g. "FULL_TIME", "PART_TIME", "INTERNSHIP"
  isActive           Boolean          @default(true)
  applications       JobApplication[]
  savedBy            SavedJob[]
  views              JobView[]
  recommendations    JobRecommendation[]
  responsibilities   String?
  requirements       String?
  experienceLevel    String?
  department         String?          // academic department code
  status             JobStatus        @default(PUBLISHED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, isActive])
  @@index([employmentType])
  @@index([department])
  @@index([deadline])
  @@index([createdAt])
}

model JobApplication {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  alumniId    String
  alumni      AlumniProfile     @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  resumeUrl   String?
  coverLetter String?
  status      ApplicationStatus @default(PENDING)
  hiredAt     DateTime?
  interviews  Interview[]
  hiringEvent HiringEvent?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum SurveyType {
  SIX_MONTH
  TWELVE_MONTH
  EIGHTEEN_MONTH
  TWENTY_FOUR_MONTH
  CUSTOM
}

enum SurveyQuestionType {
  TEXT
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
  RATING
  NUMBER
  DATE
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  EXPIRED
}

enum TracerNotificationType {
  NEW_SURVEY
  REMINDER
  OVERDUE
}

model Survey {
  id              String               @id @default(uuid())
  title           String
  description     String
  type            SurveyType           @default(CUSTOM)
  milestoneMonths Int?
  scheduledAt     DateTime?
  isActive        Boolean              @default(true)
  isArchived      Boolean              @default(false)
  /// Null = institutional (admin/registrar). Set for department-owned templates.
  departmentId    String?
  department      Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdByUserId String?
  sections        SurveySection[]
  questions       SurveyQuestion[]
  assignments     SurveyAssignment[]
  responses       SurveyResponse[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([departmentId])
  @@index([createdByUserId])
}

model SurveySection {
  id          String          @id @default(uuid())
  surveyId    String
  survey      Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  questions   SurveyQuestion[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SurveyQuestion {
  id              String            @id @default(uuid())
  surveyId        String
  survey          Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sectionId       String?
  section         SurveySection?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionText    String
  questionType    SurveyQuestionType @default(TEXT)
  required        Boolean           @default(false)
  placeholder     String?
  helpText        String?
  validationRules Json?
  options         String[]          @default([])
  order           Int
  answers         SurveyAnswer[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model SurveyAssignment {
  id                   String            @id @default(uuid())
  surveyId             String
  survey               Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  alumniId             String
  alumni               AlumniProfile     @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  status               AssignmentStatus  @default(PENDING)
  assignedAt           DateTime          @default(now())
  dueDate              DateTime
  completedAt          DateTime?
  sevenDayReminderSent Boolean           @default(false)
  threeDayReminderSent Boolean           @default(false)
  overdueReminderSent  Boolean           @default(false)
  response             SurveyResponse?
  responseId           String?           @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  tracerNotifications  TracerNotification[]
}

model SurveyResponse {
  id           String             @id @default(uuid())
  surveyId     String
  survey       Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  alumniId     String
  alumni       AlumniProfile      @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  assignment   SurveyAssignment?  @relation(fields: [assignmentId], references: [id])
  assignmentId String?            @unique
  answers      SurveyAnswer[]
  isDraft      Boolean            @default(false)
  submittedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText String         // User input or selected option
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model TracerNotification {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   SurveyAssignment?       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         TracerNotificationType
  title        String
  content      String
  isRead       Boolean                 @default(false)
  createdAt    DateTime                @default(now())
}

model EmployerFeedback {
  id                 String        @id @default(uuid())
  employerId         String
  employer           EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  alumniId           String
  alumni             AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  technicalSkill     Int           // 1 to 10 rating
  communicationSkill Int           // 1 to 10 rating
  leadershipSkill    Int           // 1 to 10 rating
  teamworkSkill      Int           // 1 to 10 rating
  problemSolvingSkill Int          // 1 to 10 rating
  innovationSkill    Int           // 1 to 10 rating
  feedbackText       String?
  overallSatisfaction Int          @default(8)
  missingSkills      String[]      @default([])
  technologiesNeeded String[]      @default([])
  wouldHireAgain     Boolean       @default(true)
  createdAt          DateTime      @default(now())
}

model DocumentRequest {
  id                     String                @id @default(uuid())
  alumniId               String
  alumni                 AlumniProfile         @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  documentType           String                // "TRANSCRIPT" | "DEGREE_VERIFICATION" | "RECOMMENDATION"
  status                 DocumentRequestStatus @default(PENDING)
  additionalInstructions String?
  fileUrls               String[]              @default([])
  notes                  String?
  contactEmail           String?
  issuedDocumentUrl      String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model VerificationRequest {
  id           String                    @id @default(uuid())
  alumniId     String
  alumni       AlumniProfile             @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  type         String                    // "ALUMNI_REGISTRATION" | "GRADUATION_STATUS"
  status       VerificationRequestStatus @default(PENDING)
  notes        String?
  documentUrl  String?
  requestDate  DateTime                  @default(now())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model RegistrarSyncLog {
  id           String     @id @default(uuid())
  syncedAt     DateTime   @default(now())
  recordsCount Int
  status       SyncStatus
  errors       String?
}

model RegistrarStudent {
  id             String   @id @default(uuid())
  studentId      String   @unique
  fullName       String
  department     String
  departmentCode String
  cgpa           Float
  graduationDate DateTime?
  graduationYear Int
  email          String?
  phone          String?
  nationality    String?
  dateOfBirth    DateTime?
  source         String
  importedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  alumniProfile  AlumniProfile?
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String    @db.Text
  type        String    @default("In-App")
  status      String    @default("Sent")
  priority    String    @default("Normal")
  category    String    @default("General")
  imageUrl    String?
  ctaLink     String?
  ctaText     String?
  scheduledAt DateTime?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String      // "ONLINE" | "IN_PERSON"
  createdBy   String      // userId of the ALUMNI_OFFICE/ADMIN who created it
  rsvps       EventRSVP[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model EventRSVP {
  id        String        @id @default(uuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alumniId  String
  alumni    AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  status    String        // "GOING" | "NOT_GOING"
  createdAt DateTime      @default(now())

  @@unique([eventId, alumniId])
}

model MentorshipRequest {
  id          String        @id @default(uuid())
  mentorId    String
  mentor      AlumniProfile @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      AlumniProfile @relation("MenteeRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  status      String        // "PENDING" | "ACCEPTED" | "REJECTED" | "COMPLETED"
  message     String?       // Introduction message
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([mentorId, menteeId])
}

model AnalyticsCache {
  key       String   @id
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   String
  interviewDate DateTime
  interviewType String          // "ONLINE" | "IN_PERSON" | "PHONE" etc.
  meetingLink   String?
  location      String?
  notes         String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([applicationId])
}

model HiringEvent {
  id            String         @id @default(uuid())
  applicationId String         @unique
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employerId    String
  alumniId      String
  departmentId  String
  hiredAt       DateTime       @default(now())
  salary        Float?
  timeToHireDays Float
  createdAt     DateTime       @default(now())

  @@index([employerId])
  @@index([alumniId])
  @@index([departmentId])
}

// ─── Job Board Models ────────────────────────────────────────────────

model SavedJob {
  id        String        @id @default(uuid())
  alumniId  String
  alumni    AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([alumniId, jobId])
  @@index([alumniId])
  @@index([jobId])
}

model JobView {
  id        String         @id @default(uuid())
  jobId     String
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewerIp  String?
  alumniId  String?
  alumni    AlumniProfile? @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([jobId])
  @@index([alumniId])
}

model JobRecommendation {
  id        String        @id @default(uuid())
  alumniId  String
  alumni    AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score     Float
  reasons   String[]
  createdAt DateTime      @default(now())
  expiresAt DateTime

  @@unique([alumniId, jobId])
  @@index([alumniId])
  @@index([score])
}

model SupportTicket {
  id             String              @id @default(uuid())
  category       String
  studentId      String?
  fullName       String
  graduationYear String?
  contactEmail   String
  phone          String?
  message        String
  attachments    String[]
  status         SupportTicketStatus @default(OPEN)
  
  // Optional metadata & admin resolution response
  route           String?
  lastErrorCode   String?
  sessionId       String?
  responseNotes   String?
  escalationNotes String?
  assignedToRole  String?
  resolvedByRole  String?
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model DirectMessage {
  id           String           @id @default(uuid())
  senderId     String           @default("")
  receiverId   String           @default("")
  employerId   String?
  employer     EmployerProfile? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  alumniId     String?
  alumni       AlumniProfile?   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  sender       String           // "EMPLOYER", "ALUMNI", "ADMIN", "REGISTRAR", "DEPARTMENT_HEAD"
  receiverRole String?
  text         String
  fileUrl      String?
  fileType     String?
  isRead       Boolean          @default(false)
  deletedBy    String[]         @default([])
  isDeleted    Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([employerId])
  @@index([alumniId])
}

// ----------------------------------------------------------------------
// NEW MODELS FOR ALUMNI DASHBOARD (COMMUNITY, MENTORSHIP, GIVING, EVENTS)
// ----------------------------------------------------------------------

model CareerEvent {
  id              String   @id @default(uuid())
  title           String
  date            DateTime
  location        String
  description     String?
  registeredCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registrations   EventRegistration[]
}

model EventRegistration {
  id          String        @id @default(uuid())
  eventId     String
  event       CareerEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alumniId    String
  alumni      AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([eventId, alumniId])
}

model MentorProfile {
  id              String   @id @default(uuid())
  alumniId        String   @unique
  alumni          AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  expertise       String[]
  availability    String   // e.g. 'Available', 'Unavailable'
  yearsExperience Int      @default(0)
  status          String   @default("AVAILABLE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mentorshipSessions MentorshipSession[]
}

model MentorshipSession {
  id          String        @id @default(uuid())
  mentorId    String
  mentor      MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      AlumniProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  date        DateTime
  time        String
  topic       String
  status      String        @default("PENDING") // PENDING, SCHEDULED, COMPLETED, CANCELLED
  meetLink    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DonationCampaign {
  id          String     @id @default(uuid())
  title       String
  description String?
  category    String     @default("General")
  goal        Float      @default(0)
  raised      Float      @default(0)
  donorCount  Int        @default(0)
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  donations   DonationRecord[]
}

model DonationRecord {
  id          String           @id @default(uuid())
  campaignId  String
  campaign    DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  alumniId    String
  alumni      AlumniProfile    @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  amount      Float
  paymentRef  String?
  createdAt   DateTime         @default(now())
}

model ForumPost {
  id          String         @id @default(uuid())
  alumniId    String
  alumni      AlumniProfile  @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  content     String
  likesCount  Int            @default(0)
  commentsCount Int          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  comments    ForumComment[]
  likes       ForumLike[]
}

model ForumComment {
  id          String        @id @default(uuid())
  postId      String
  post        ForumPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  alumniId    String
  alumni      AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ForumLike {
  id          String        @id @default(uuid())
  postId      String
  post        ForumPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  alumniId    String
  alumni      AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([postId, alumniId])
}

model RegistrationIssue {
  id                String   @id @default(uuid())
  fullName          String
  studentId         String
  graduationYear    String
  contactEmail      String
  phoneNumber       String
  issueDescription  String
  identificationUrl String
  status            String   @default("PENDING") // PENDING, RESOLVED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ExportLog {
  id          String   @id @default(uuid())
  reportName  String
  format      String   // "PDF" | "Excel" | "Stata" | "CSV"
  exportedBy  String   @default("Registrar Admin")
  recordCount Int      @default(0)
  fileSize    String   @default("0 KB")
  createdAt   DateTime @default(now())
}

model ScheduledReport {
  id        String   @id @default(uuid())
  title     String
  format    String   // "PDF" | "Excel" | "CSV"
  schedule  String   // "Every 1st of month" | "Every Monday" | "Quarterly"
  nextRun   String   // e.g. "Jun 1, 2026"
  status    String   @default("Active") // "Active" | "Paused" | "Completed"
  createdBy String   @default("Registrar Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

