# Database Configuration
# Update the password if your local postgres user has one
DATABASE_URL="postgresql://postgres:password@localhost:5432/astu_ams"
# DATABASE_URL="postgresql://astu_user:password@localhost:5432/astu_ams"
# Application Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Frontend Integration
FRONTEND_URL="http://localhost:5173"

# AI Integration (OpenRouter for Gemini/Claude)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Third Party Integrations
DIDIT_API_KEY="your_didit_api_key_here"
REGISTRAR_API_URL="https://registrar.astu.edu.et/api/v1"
REGISTRAR_API_KEY="your_registrar_api_key_here"
