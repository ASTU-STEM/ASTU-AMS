PORT=5000
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_REFRESH_EXPIRY="7d"

# Registrar API Integration Configuration
REGISTRAR_API_URL="https://registrar.astu.edu.et/api/v1"
REGISTRAR_API_KEY="your_registrar_api_key_here"

# Email Configuration (Mocked/SMTP)
FRONTEND_URL="http://localhost:5173"
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="your_smtp_user@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="your_smtp_user@example.com"

# File Upload Limit in Bytes (default 5MB)
MAX_FILE_SIZE=5242880
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL="deepseek/deepseek-r1:free"
